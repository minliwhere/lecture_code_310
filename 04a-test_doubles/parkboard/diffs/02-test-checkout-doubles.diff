    TEST-0010: test checkout with test doubles
    
    The tests hand checkout() stand-ins for CoastPay, so nobody is charged:
    
    - ApprovingProcessor and DecliningProcessor always give the same
      answer, so each test picks the outcome it needs.
    - RecordingProcessor remembers every amount it's asked to charge, so a
      test can check that checkout() charged the price of the offering, in
      cents.
    
    All three keep PaymentProcessor's contract: they return true or false,
    and never throw.
    
    The expected amount comes from the real priceFor(). It's fast, gives
    the same answer every time, and has no side effects, so there's no
    reason to replace it.

diff --git a/test/payment.spec.ts b/test/payment.spec.ts
index 48ea438..0d544c2 100644
--- a/test/payment.spec.ts
+++ b/test/payment.spec.ts
@@ -1,4 +1,57 @@
 import { expect } from "chai";
-import { checkout } from "../src/payment";
+import { checkout, PaymentProcessor } from "../src/payment";
+import { findCustomer, findOffering } from "../src/catalogue";
 
-describe("checkout", () => {});
+// stand-ins for CoastPay: each always gives the same answer
+class ApprovingProcessor implements PaymentProcessor {
+	public charge(cents: number): boolean {
+		return true;
+	}
+}
+
+class DecliningProcessor implements PaymentProcessor {
+	public charge(cents: number): boolean {
+		return false;
+	}
+}
+
+// remembers every amount it's asked to charge, and approves
+class RecordingProcessor implements PaymentProcessor {
+	public charged: number[] = [];
+
+	public charge(cents: number): boolean {
+		this.charged.push(cents);
+		return true;
+	}
+}
+
+describe("checkout", () => {
+	it("registers the customer when the card is charged", () => {
+		const offering = findOffering("FT-110-B")!;
+		const customer = findCustomer("c11")!;
+
+		checkout(offering, customer, new ApprovingProcessor());
+
+		expect(offering.isRegistered(customer)).to.equal(true);
+	});
+
+	it("does not register the customer when the card is declined", () => {
+		const offering = findOffering("FT-110-B")!;
+		const customer = findCustomer("c12")!;
+
+		checkout(offering, customer, new DecliningProcessor());
+
+		expect(offering.isRegistered(customer)).to.equal(false);
+	});
+
+	it("charges the price of the offering, in cents", () => {
+		const offering = findOffering("FT-110-B")!;
+		const customer = findCustomer("c13")!;
+		const processor = new RecordingProcessor();
+
+		checkout(offering, customer, processor);
+
+		// priceFor(offering, customer) is $117.81 for a resident adult
+		expect(processor.charged).to.deep.equal([11781]);
+	});
+});
