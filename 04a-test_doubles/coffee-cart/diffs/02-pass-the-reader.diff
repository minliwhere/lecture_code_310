diff --git a/src/cart.ts b/src/cart.ts
index f9fe7da..c3bc791 100644
--- a/src/cart.ts
+++ b/src/cart.ts
@@ -1,3 +1,9 @@
-export function buyCoffee(charged: boolean): string {
-	return charged ? "enjoy your coffee" : "card declined";
+/** Whatever the cart charges a card through. */
+export interface CardReader {
+	/** Returns true if the card was charged, false if it was declined. Never throws. */
+	charge(cents: number): boolean;
+}
+
+export function buyCoffee(reader: CardReader): string {
+	return reader.charge(450) ? "enjoy your coffee" : "card declined";
 }
