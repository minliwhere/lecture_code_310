    FEAT-0001: add YouTube Music
    
    YouTube Music exports XML, and calls a play a video: title, channel,
    views, category. YouTubeMusicSource parses that export and adapts it to
    MusicSource, and index.ts hands it to MyWrapped.
    
    MyWrapped didn't change: neither report needed a new loop.

diff --git a/src/adapters.ts b/src/adapters.ts
index ac8f38a..eb65862 100644
--- a/src/adapters.ts
+++ b/src/adapters.ts
@@ -1,5 +1,6 @@
 import { MusicRecord, MusicSource } from "./MusicSource";
 import { parseCSV } from "./utils/csvParser";
+import { parseXML } from "./utils/xmlParser";
 
 export class SpotifySource implements MusicSource {
 	private plays: any[];
@@ -36,3 +37,21 @@ export class AppleMusicSource implements MusicSource {
 		}));
 	}
 }
+
+export class YouTubeMusicSource implements MusicSource {
+	private videos: Record<string, string>[];
+
+	constructor(xml: string) {
+		this.videos = parseXML(xml, "video");
+	}
+
+	getRecords(): MusicRecord[] {
+		return this.videos.map((video) => ({
+			id: video.videoId,
+			track: video.title,
+			artist: video.channel,
+			streams: parseInt(video.views, 10),
+			genre: video.category,
+		}));
+	}
+}
