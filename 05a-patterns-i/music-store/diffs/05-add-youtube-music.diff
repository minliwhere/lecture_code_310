    FEAT-0001: add YouTube Music
    
    YouTube Music's SDK calls a play a watched video: listWatchedVideos()
    returns videos with a title, channel, views, and category.
    YouTubeMusicAdapter wraps a YouTubeMusicApi and translates those into
    MusicRecords, and index.ts hands it to MyWrapped.
    
    MyWrapped didn't change: neither report needed a new loop.

diff --git a/src/adapters.ts b/src/adapters.ts
index a5dce42..4abd91e 100644
--- a/src/adapters.ts
+++ b/src/adapters.ts
@@ -1,6 +1,7 @@
 import { MusicRecord, MusicSource } from "./MusicSource";
 import { SpotifyClient } from "./vendor/spotify";
 import { AppleMusicLibrary } from "./vendor/appleMusic";
+import { YouTubeMusicApi } from "./vendor/youtubeMusic";
 
 export class SpotifyAdapter implements MusicSource {
 	constructor(private client: SpotifyClient) {}
@@ -29,3 +30,17 @@ export class AppleMusicAdapter implements MusicSource {
 		}));
 	}
 }
+
+export class YouTubeMusicAdapter implements MusicSource {
+	constructor(private client: YouTubeMusicApi) {}
+
+	getRecords(): MusicRecord[] {
+		return this.client.listWatchedVideos().map((video) => ({
+			id: video.videoId,
+			track: video.title,
+			artist: video.channel,
+			streams: parseInt(video.views, 10),
+			genre: video.category,
+		}));
+	}
+}
